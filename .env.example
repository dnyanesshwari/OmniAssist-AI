# --- required ---
DATABASE_URL=postgresql+psycopg://omni:change_me@localhost:5432/omniassist
GEMINI_API_KEY=
JWT_SECRET=change_me_to_a_long_random_string

# --- models ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
LLM_MODEL=gemini-2.5-flash

# --- RAG ---
DOCS_DIR=../data/documents
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55

# --- agent / voice ---
MAX_FAILURES=3
ALLOW_FAILURE_INJECTION=false
VOICE_IDLE_SECONDS=20
SERVER_TTS=false
CORS_ORIGINS=["http://localhost:5173"]
